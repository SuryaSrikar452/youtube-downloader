# Port to run the application on (defaults to 3000)
PORT=3000

# ==============================================================================
# YouTube Cookie Authentication Settings
# ==============================================================================
# There are two methods to configure YouTube cookie authentication in this app:
#
# METHOD 1: Render Secret File (Recommended & Primary)
# For deployments on Render, upload your cookies.txt (Netscape format) as a 
# Render Secret File at:
# /etc/secrets/cookies.txt
#
# METHOD 2: Environment Variable (Fallback / Local Dev)
# Set YOUTUBE_COOKIES with the raw or base64-encoded content of a Netscape format 
# cookies.txt file. This will be written to bin/cookies.txt on startup.
# Example (Base64 or Raw String):
YOUTUBE_COOKIES=
